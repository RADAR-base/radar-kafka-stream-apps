{
    "namespace": "org.radarbase.stream.ruleengine.avro",
    "name": "AppConfigKey",
    "type": "record",
    "doc": "Reverse-engineered from raw bytes on the rule_engine_config topic (see docs/rule-engine-global-store-findings.md) - the real Confluent Schema Registry that wrote this data isn't reachable from this repo, so this is not a registry-fetched schema.",
    "fields": [
        {"name": "scope", "type": ["null", "string"], "default": null, "doc": "'global', 'project.<id>', or 'user.<id>'."},
        {"name": "name", "type": ["null", "string"], "default": null, "doc": "Rule name within the scope, e.g. 'rule4'."}
    ]
}
